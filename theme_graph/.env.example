# Source this file explicitly; Python server.py does not auto-load .env files.
# Adjust these absolute paths to your own checkout/data locations.
export TRADING_DATA_MANAGER_ROOT="$HOME/TradingDataManager"
export TRADING_DATABASE_ROOT="$HOME/TradingDataBase"
export TRADING_LIMITUP_GRAPH_DB="$TRADING_DATABASE_ROOT/theme_graph/topic_limitup_graph.sqlite3"
export TRADING_THEME_NEO4J_URI="bolt://127.0.0.1:17687"
export TRADING_THEME_NEO4J_USERNAME="neo4j"
export TRADING_THEME_NEO4J_DATABASE="neo4j"
# Password is supplied privately in the shell or a file, never this template:
# export TRADING_THEME_NEO4J_PASSWORD_FILE="$HOME/.config/trading/neo4j-password"
export TRADINGALERT_HOST="127.0.0.1"
export TRADINGALERT_PORT="8765"
# Optional Redis cache. Without Redis the dashboard uses its SQLite cache.
export TRADINGALERT_REDIS_URL="redis://127.0.0.1:6379/2"
# Optional generation through the existing vLLM transport; no LLM required for demo.
# export THEME_VLLM_BASE_URL="http://127.0.0.1:8002/v1"
# export THEME_VLLM_MODEL="your-model-id"
# export HERMES_BIN="$HOME/.local/bin/hermes"
