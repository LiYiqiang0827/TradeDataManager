# Copy to a private file outside Git, then set values on the target computer.
# Example: export TRADING_AGENT_ENV_FILE="$HOME/.config/trading-data-manager.env"
TRADING_DATA_MANAGER_ROOT=/path/to/TradingDataManager
TRADING_DATABASE_ROOT=/path/to/TradingDatabase
TRADING_RESEARCH_ROOT=/path/to/TradingAgent/MrLi
TRADING_AGENT_TUSHARE_TOKEN=

# KPL credentials are read from ~/.kpl-api/.auth.json (keys: token, user_id).
# Keep that file outside this repository and restrict it to the current user.
# No privateconfig.py is required; do not place credentials in *_config.py.
